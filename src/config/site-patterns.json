{
  "xiaohongshu.com": {
    "platform": "小红书网页版",
    "version": "1.0.0",
    "meta": {
      "homeUrl": "https://www.xiaohongshu.com",
      "searchUrlTemplate": "https://www.xiaohongshu.com/search_result?keyword={keyword}"
    },
    "patterns": {
      "interaction": {
        "openDetailMethod": "navigate_url",
        "scrollStyle": "human_stepped"
      },
      "traps": {
        "loginDialog": {
          "detectSelector": ".login-container, .modal-mask",
          "strategy": "check_user_auth_or_prompt"
        },
        "rateLimit": {
          "detectKeywords": [
            "当前笔记暂时无法浏览",
            "请打开小红书App扫码查看",
            "操作过于频繁",
            "访问被拒绝",
            "网络异常",
            "安全验证",
            "滑动验证"
          ],
          "detectSelector": ".qrcode-img, [class*='qrcode'], .verify-box, div[class*='verify']",
          "code": 300031,
          "cooldownSeconds": 300
        }
      },
      "selectors": {
        "search": {
          "input": ["#search-input", "input.search-input", "input[placeholder*='搜索']"],
          "searchButton": [".search-btn", "button[type='submit']"],
          "feedsContainer": [
            ".feeds-page",
            ".search-result-feeds",
            ".feeds-container",
            ".search-layout",
            ".search-layout-content",
            ".search-result-container",
            "div[class*='feeds-container']",
            "div[class*='search-result']",
            "section[class*='feed']",
            "#global",
            "main",
            "body"
          ],
          "noteCard": [".note-item", "section.note-card", "div[data-note-id]", "section[class*='note-card']"],
          "noteLink": [".note-item a.cover", "a[href*='/explore/']", "a[href*='/search_result/']"]
        },
        "noteDetail": {
          "container": [
            "#noteContainer",
            ".note-container",
            ".interaction-container",
            ".note-scroller",
            ".note-detail-mask",
            ".note-flow",
            "div[class*='note-container']",
            "div[class*='interaction']",
            "div[class*='note-detail']",
            "body"
          ],
          "title": [".note-title", "#detail-title", "h1[class*='title']", "[class*='title']"],
          "content": [".note-content", ".content-text", "[class*='content-desc']", "[class*='note-text']"],
          "commentSection": [".comments-container", ".comment-wrapper", ".comments-el", "div[class*='comment']"],
          "commentItem": [".comment-item", "div[class*='comment-item']"]
        }
      }
    },
    "recipes": {
      "searchAndCollect": [
        { "action": "navigate", "url": "{searchUrlTemplate}" },
        { "action": "waitFor", "selectorKey": "search.feedsContainer", "timeout": 10000 },
        { "action": "loopScroll", "count": "{scrollTimes}", "style": "human_stepped" },
        { "action": "extractBatch", "selectorKey": "search.feedsContainer", "extractor": "llm.extractNoteList" }
      ],
      "collectNoteDetail": [
        { "action": "click", "selectorKey": "search.noteLink", "targetIndex": "{index}" },
        { "action": "waitFor", "selectorKey": "noteDetail.container", "timeout": 8000 },
        { "action": "extract", "selectorKey": "noteDetail.container", "extractor": "llm.extractNoteDetail" },
        { "action": "extract", "selectorKey": "noteDetail.commentSection", "extractor": "llm.extractComments" },
        { "action": "closeModal", "strategy": "click_mask_or_esc" }
      ]
    }
  }
}
